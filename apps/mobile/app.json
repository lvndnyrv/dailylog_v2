{
  "expo": {
    "name": "DailyLog",
    "slug": "dailylog",
    "scheme": "dailylog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dailylog.app",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "DailyLog sends you notifications when your child's daily log is ready to view.",
        "NSPhotoLibraryUsageDescription": "DailyLog needs access to your photos to attach them to daily logs.",
        "NSCameraUsageDescription": "DailyLog needs camera access to take photos for daily logs."
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.dailylog.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#2F7CD8"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2F7CD8",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DailyLog needs access to your photos to attach them to daily logs.",
          "cameraPermission": "DailyLog needs camera access to take photos for daily logs."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "DailyLog uses the camera to scan short-lived family pickup passes at the door.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "DailyLog can add center closures to your calendar when you choose Add to my calendar."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F4F8FD"
        }
      ]
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      },
      "storeUrls": {
        "ios": "YOUR_IOS_APP_STORE_URL",
        "android": "YOUR_ANDROID_PLAY_STORE_URL"
      }
    }
  }
}
