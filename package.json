{
  "name": "dailylog",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck && tsc -p supabase/functions/tsconfig.json --noEmit",
    "lint": "pnpm -r --if-present lint",
    "dev:web": "pnpm --filter @dailylog/web dev",
    "dev:mobile": "pnpm --filter @dailylog/mobile start",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "gen:types": "supabase gen types typescript --local > packages/db/src/types.gen.ts",
    "validate:mobile-release": "pnpm --filter @dailylog/mobile validate:release"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
